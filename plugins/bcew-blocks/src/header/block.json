{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bcew-blocks/header",
    "version": "0.1.0",
    "title": "Header",
    "category": "theme",
    "keywords": [ "header", "logo", "menu" ],
    "icon": "admin-home",
    "description": "Site header with the logo, menus, search, and breadcrumb.",
    "attributes": {
        "align": {
            "type": "string",
            "default": "wide"
        },
        "backgroundColor": {
            "type": "string",
            "default": "base"
        },
        "style": {
            "type": "object",
            "default": {
                "spacing": {
                    "padding": {
                        "left": "var:preset|spacing|50",
                        "right": "var:preset|spacing|50"
                    }
                }
            }
        }
    },
    "supports": {
        "html": false,
        "align": [ "left", "center", "right", "wide", "full" ],
        "color": {
            "text": true,
            "background": true,
            "gradients": false
        },
        "spacing": {
            "margin": false,
            "padding": [ "left", "right" ]
        }
    },
    "textdomain": "bcew-blocks",
    "editorScript": "file:./index.js",
    "style": "file:./style-index.css",
    "render": "file:./render.php"
}
