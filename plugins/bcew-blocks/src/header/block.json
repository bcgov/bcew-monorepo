{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bcew-blocks/header",
    "version": "0.1.0",
    "title": "Header",
    "category": "theme",
    "keywords": [ "header", "logo", "menu" ],
    "icon": "admin-home",
    "description": "Site header with the logo, menus, search, and breadcrumb.",
    "attributes": {
        "backgroundColor": {
            "type": "string",
            "default": "base"
        },
        "showSearch": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "gradients": false
        },
        "spacing": {
            "margin": false,
            "padding": false
        }
    },
    "textdomain": "bcew-blocks",
    "editorScript": "file:./index.js",
    "style": "file:./style-index.css",
    "render": "file:./render.php"
}
