{
    "name": "bcgov-plugin/bcew-blocks",
    "description": "Plugin containing blocks intended to be used with the Design System WordPress Theme suite of products.",
    "type": "wordpress-plugin",
    "license": "Apache-2.0",
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/phpunit-config",
            "options": {
                "symlink": false
            }
        }
    ],
    "require-dev": {
        "bcew-monorepo/phpunit-config": "@dev",
        "phpunit/phpunit": "^9.5",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Bcew\\Blocks\\": "src/",
            "Bcew\\Blocks\\Test\\": "tests/php/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.30"
        }
    }
}
