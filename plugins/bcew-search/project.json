{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "bcew-search",
    "root": "plugins/bcew-search",
    "sourceRoot": "plugins/bcew-search/src",
    "projectType": "application",
    "generators": {
        "bcew-monorepo:plugin": {
            "name": "BC Extended Web Search",
            "description": "BC Extended Web Search"
        }
    },
    "targets": {
        "composer-install": {},
        "build": {
            "options": {
                "command": "npm run build",
                "forwardAllArgs": false
            },
            "outputs": [
                "{projectRoot}/build",
                "{projectRoot}/Blocks/build"
            ]
        },
        "start": {
            "options": {
                "command": "npm run start",
                "forwardAllArgs": false
            }
        },
        "start-playwright": {},
        "test-e2e": {},
        "test-e2e-docker": {},
        "test-screenshot": {},
        "test-screenshot-generate": {},
        "test-integration": {
            "dependsOn": ["composer-install", "build", "wp-env-start"],
            "options": {
                "command": "wp-env run tests-cli --env-cwd=wp-content/plugins/bcew-search composer test"
            }
        },
        "wp-env-start": {},
        "wp-env-clean": {},
        "wp-env-stop": {}
    },
    "implicitDependencies": ["packages/phpunit-config/"],
    "tags": ["type:wp-plugin"]
}
