{
    "name": "wordpress-document-repository",
    "version": "1.0.0",
    "description": "Wordpress Document Repository Plugin",
    "author": "govwordpress@gov.bc.ca",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "WordPress",
        "BCGov",
        "Gutenberg",
        "plugin"
    ],
    "homepage": "https://github.com/bcgov/bcew-monorepo/plugins/wordpress-document-repository",
    "repository": {
        "type": "git",
        "url": "https://github.com/bcgov/bcew-monorepo.git",
        "directory": "plugins/wordpress-document-repository"
    },
    "bugs": {
        "url": "https://github.com/bcgov/bcew-monorepo/issues",
        "email": "govwordpress@gov.bc.ca"
    },
    "dependencies": {
        "@wordpress/api-fetch": "^6.55.0",
        "@wordpress/components": "^25.16.0",
        "@wordpress/element": "^5.35.0",
        "@wordpress/i18n": "^4.58.0",
        "@wordpress/icons": "^11.3.0"
    },
    "devDependencies": {
        "@bcew-monorepo/e2e": "workspace:*",
        "@playwright/test": "catalog:",
        "@wordpress/e2e-test-utils-playwright": "catalog:"
    },
    "scripts": {
        "build:doc-repo": "wp-scripts build --webpack-src-dir=assets/js/apps/document-repository --output-path=build/document-repository",
        "build:metadata-settings": "wp-scripts build --webpack-src-dir=assets/js/apps/metadata-settings --output-path=build/metadata-settings",
        "build:css": "wp-scripts build --webpack-src-dir=assets/scss --output-path=build/css",
        "start": "webpack --config webpack.config.js --watch",
    }
}
