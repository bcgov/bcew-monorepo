{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "wordpress-document-repository",
    "root": "plugins/wordpress-document-repository",
    "sourceRoot": "plugins/wordpress-document-repository/src",
    "projectType": "application",
    "generators": {
        "bcew-monorepo:plugin": {
            "name": "Wordpress Document Repository",
            "description": "Wordpress Document Repository Plugin"
        }
    },
    "targets": {
        "composer-install": {},
        "build": {
            "options": {
                "command": "npm run build:doc-repo && npm run build:metadata-settings && npm run build:css"
            }
        },
        "start": {},
        "start-playwright": {},
        "test-e2e": {},
        "test-e2e-docker": {},
        "test-integration": {},
        "wp-env-start": {},
        "wp-env-clean": {},
        "wp-env-stop": {}
    },
    "implicitDependencies": ["packages/phpunit-config/"],
    "tags": ["type:wp-plugin"]
}
