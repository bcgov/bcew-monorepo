{
    "name": "bcgov-plugin/design-system-wordpress-plugin",
    "description": "Design System WordPress Plugin",
    "type": "wordpress-plugin",
    "license": "Apache-2.0",
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/phpunit-config",
            "options": {
                "symlink": false
            }
        }
    ],
    "require-dev": {
        "bcew-monorepo/phpunit-config": "@dev",
        "phpunit/phpunit": "^9.5",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Bcgov\\DesignSystemPlugin\\": "src/",
            "Bcgov\\DesignSystemPlugin\\Test\\": "tests/php/"
        }
    },
    "scripts": {
        "test": [
            "./vendor/bin/phpunit -c vendor/bcew-monorepo/phpunit-config/phpunit.integration.xml"
        ]
    },
    "config": {
        "platform": {
            "php": "7.4.30"
        }
    }
}
