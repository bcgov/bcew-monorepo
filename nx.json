{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "targetDefaults": {
        "composer:install": {
            "executor": "nx:run-commands",
            "options": {
                "command": "composer install"
            },
            "cache": true,
            "inputs": [ "{workspaceRoot}/composer.json" ],
            "outputs": [ "{workspaceRoot}/vendor" ]
        },
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "command": "wp-scripts build"
            },
            "dependsOn": [ "^build" ],
            "cache": true,
            "outputs": [ "{workspaceRoot}/dist" ]
        },
        "start": {
            "executor": "nx:run-commands",
            "options": {
                "command": "wp-scripts start"
            },
            "dependsOn": [ "^build" ],
            "continuous": true,
            "outputs": [ "{workspaceRoot}/dist" ]
        },
        "test:unit:js": {
            "executor": "nx:run-commands",
            "options": {
                "command": "wp-scripts test-unit-js",
                "cwd": "{workspaceRoot}",
                "passWithNoTests": true
            },
            "dependsOn": [ "^build" ]
        },
        "test:e2e": {
            "executor": "nx:run-commands",
            "options": {
                "command": "wp-scripts test-playwright",
                "cwd": "{workspaceRoot}"
            },
            "dependsOn": [ "^build", "wp-env:start" ] 
        },
        "test": {
            "dependsOn": [ "^build" ]
        },
        "wp-env:start": {
            "executor": "nx:run-commands",
            "options": {
                "command": "wp-env start",
                "xdebug": "coverage"
            }
        }
    },
    "namedInputs": {
        "default": [ "{projectRoot}/**/*", "sharedGlobals" ],
        "sharedGlobals": []
    },
    "release": {
        "changelog": {
            "workspaceChangelog": {
                "createRelease": "github"
            }
        }
    }
}
