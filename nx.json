{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "origin/main",
    "targetDefaults": {
        "composer-install": {
            "executor": "nx:run-commands",
            "options": {
                "command": "composer install",
                "cwd": "{projectRoot}"
            },
            "parallelism": false
        },
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "command": "wp-scripts build",
                "cwd": "{projectRoot}",
                "output-path": "dist",
                "blocks-manifest": ""
            },
            "inputs": ["buildInputs"],
            "outputs": ["{projectRoot}/dist"],
            "cache": true
        },
        "start": {
            "executor": "nx:run-commands",
            "options": {
                "command": "wp-scripts start",
                "cwd": "{projectRoot}",
                "output-path": "dist",
                "blocks-manifest": ""
            },
            "continuous": true
        },
        "start-playwright": {
            "executor": "nx:run-commands",
            "options": {
                "command": "docker compose ps --status running --services | grep -qx playwright || docker compose up -d playwright"
            }
        },
        "test-integration": {
            "executor": "nx:run-commands",
            "options": {
                "command": "wp-env run tests-cli --env-cwd=wp-content/{projectRoot} vendor/bin/phpunit -c vendor/bcew-monorepo/phpunit-config/phpunit.integration.xml --testsuite integration",
                "cwd": "{projectRoot}"
            },
            "dependsOn": ["composer-install", "wp-env-start"]
        },
        "test-e2e": {
            "executor": "nx:run-commands",
            "options": {
                "command": "wp-scripts test-playwright",
                "cwd": "{projectRoot}"
            },
            "dependsOn": ["composer-install", "build", "wp-env-start"]
        },
        "test-e2e-docker": {
            "executor": "nx:run-commands",
            "options": {
                "command": "docker exec playwright sh -c \"cd {projectRoot} && npx wp-scripts test-playwright\""
            },
            "dependsOn": [
                "composer-install",
                "start-playwright",
                "build",
                "wp-env-start"
            ]
        },
        "test-screenshot": {
            "executor": "nx:run-commands",
            "options": {
                "command": "docker exec playwright sh -c \"cd {projectRoot} && npx wp-scripts test-playwright --config playwright.regression.config.js --update-snapshots none\""
            },
            "dependsOn": [
                "composer-install",
                "start-playwright",
                "build",
                "wp-env-start"
            ]
        },
        "test-screenshot-generate": {
            "executor": "nx:run-commands",
            "options": {
                "command": "docker exec playwright sh -c \"cd {projectRoot} && npx wp-scripts test-playwright --config playwright.regression.config.js --update-snapshots all\""
            },
            "parallelism": false,
            "dependsOn": [
                "composer-install",
                "start-playwright",
                "build",
                "wp-env-start"
            ]
        },
        "wp-env-start": {
            "executor": "nx:run-commands",
            "options": {
                "command": "wp-env start",
                "cwd": "{projectRoot}",
                "xdebug": "coverage"
            },
            "dependsOn": ["composer-install"],
            "parallelism": false
        },
        "wp-env-clean": {
            "executor": "nx:run-commands",
            "options": {
                "command": "wp-env clean",
                "cwd": "{projectRoot}"
            }
        },
        "wp-env-stop": {
            "executor": "nx:run-commands",
            "options": {
                "command": "sh -c 's=$(wp-env status --json 2>/dev/null); echo \"$s\" | grep -q uninitialized && exit 0; echo \"$s\" | grep -qF \"\\\"status\\\":\\\"stopped\\\"\" && exit 0; exec wp-env stop'",
                "cwd": "{projectRoot}"
            }
        },
        "lint-template-parts": {
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/validate-template-parts.mjs {projectRoot}"
            },
            "inputs": [
                "{projectRoot}/parts/**/*.html",
                "{projectRoot}/templates/**/*.html",
                "{workspaceRoot}/tools/validate-template-parts.mjs"
            ],
            "cache": true
        }
    },
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "buildInputs": [
            "{projectRoot}/**",
            "!{projectRoot}/dist/**",
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/pnpm-lock.json"
        ],
        "sharedGlobals": []
    },
    "release": {
        "changelog": {
            "workspaceChangelog": {
                "createRelease": "github"
            }
        }
    },
    "parallel": 3,
    "analytics": true,
    "plugins": [
        {
            "plugin": "@nx/playwright/plugin",
            "options": {
                "targetName": "e2e"
            }
        }
    ]
}
