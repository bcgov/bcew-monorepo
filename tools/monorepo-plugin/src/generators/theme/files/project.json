{
  "name": "<%= slug %>",
  "root": "themes/<%= slug %>",
  "sourceRoot": "themes/<%= slug %>/src",
  "projectType": "application",
  "generators": {
    "wordpress-monorepo:theme-generator": {
        "name": "<%= name %>",
        "slug": "<%= slug %>"
    }
  },
  "targets": {
    "composer:install": {},
    "build": {
      "options": {
        "source-path": "plugins/<%= slug %>/src",
        "output-path": "plugins/<%= slug %>/dist"
      }
    },
    "start": {
      "options": {
        "source-path": "plugins/<%= slug %>/src",
        "output-path": "plugins/<%= slug %>/dist"
      }
    },
    "test:unit:js": {},
    "test:e2e": {
        "options": {
            "config": "plugins/<%= slug %>/playwright.config.js"
        }
    },
    "wp-env:start": {
        "options": {
            "config": "plugins/<%= slug %>/.wp-env.json",
            "cwd": "{workspaceRoot}"
        }
    }
  },
  "implicitDependencies": ["packages/phpunit-config/"],
  "tags": ["type:wp-theme"]
}
