{
    "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
    "version": 3,
    "title": "bcew-starter-theme",
    "customTemplates": [
        {
            "name": "secondary",
            "title": "Pages Secondary"
        },
        {
            "name": "wide-page",
            "title": "Pages Wide"
        }
    ],
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        }
        
    ],
    "settings": {
        "appearanceTools": false,
        "color": {
            "defaultPalette": true,
            "palette": [
                {
                    "name": "Surface Primary Default",
                    "slug": "surface-primary",
                    "color": "var(--bcds-surface-color-primary-default)"
                },
                {
                    "name": "Typography Primary Invert",
                    "slug": "typography-primary-invert",
                    "color": "var(--bcds-typography-color-primary-invert)"
                }
                
            ]
        },
        "layout": {
            "contentSize": "75rem",
            "wideSize": "80rem"
        },
        "blocks": {
            "core/list": {
                "typography": {
                    "defaultFontSizes": false,
                    "customFontSize": false
                }
            },
            "core/list-item": {
                "typography": {
                    "customFontSize": false,
                    "defaultFontSizes": false,
                    "fontFamilies": [],
                    "fontSizes": [],
                    "fontStyle": false,
                    "fontWeight": false,
                    "lineHeight": false,
                    "letterSpacing": false,
                    "textDecoration": false,
                    "textTransform": false,
                    "textAlign": false,
                    "writingMode": false
                }
            }
        },
        "typography": {
            "defaultFontSizes": false,
            "lineHeight": false,
            "customFontSize": false,
            "letterSpacing": false,
            "textTransform": false,
            "fontWeight": false,
            "fontStyle": false
        },
        "background": {
            "backgroundImage": false
        },
        "shadow":{
            "defaultPresets": false,
            "presets": []
        },
        "spacing": {
            "padding": false,
            "blockGap": false,
            "defaultSpacingSizes": false,
            "customSpacingSize": false,
            "spacingSizes": [
                {
                    "name": "2X-Small",
                    "slug": "20",
                    "size": "var(--bcds-layout-margin-hair)"
                },
                {
                    "name": "X-Small",
                    "slug": "30",
                    "size": "var(--bcds-layout-padding-xsmall)"
                },
                {
                    "name": "Small",
                    "slug": "40",
                    "size": "var(--bcds-layout-margin-small)"
                },
                {
                    "name": "Medium",
                    "slug": "50",
                    "size": "var(--bcds-layout-margin-medium)"
                },
                {
                    "name": "Large",
                    "slug": "60",
                    "size": "var(--bcds-layout-margin-large)"
                },
                {
                    "name": "X-Large",
                    "slug": "70",
                    "size": "var(--bcds-layout-margin-xlarge)"
                },
                {
                    "name": "2X-Large",
                    "slug": "80",
                    "size": "var(--bcds-layout-margin-xxlarge)"
                },
                {
                    "name": "3x-Large",
                    "size": "var(--bcds-layout-margin-xxxlarge)",
                    "slug": "90"
                }
        
            ]
        }
    },
    "styles": {
        "color": {
            "text": "var(--bcds-typography-color-primary)"
        },
        
        "typography": {
            "fontFamily": "var(--bcds-typography-font-families-bc-sans), Noto Sans, Verdana, Arial, sans-serif",
            "fontSize": "var(--bcds-typography-font-size-body)",
            "fontWeight": "var(--bcds-typography-font-weights-regular)",
            "lineHeight": "var(--bcds-typography-line-heights-regular)"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--bcds-typography-color-link)"
                }
            },
            "button": {
                ":hover": {
                    "color": {
                        "background": "color-mix(in srgb, var(--wp--preset--color--surface-primary) 80%, white 20%);"
                    }
                },
                "color": {
                    "text": "var:preset|color|typography-primary-invert",
                    "background": "var:preset|color|surface-primary"
                },
                "border": {
                    "radius": "var(--bcds-layout-border-radius-medium)",
                    "width": "var(--bcds-layout-border-width-small)"
                },
                "spacing": {
                    "padding": {
                        "top": "var:preset|spacing|40",
                        "right": "var:preset|spacing|50",
                        "bottom": "var:preset|spacing|40",
                        "left": "var:preset|spacing|50"
                    }
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var(--bcds-typography-font-size-h1)"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var(--bcds-typography-font-size-h2)"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var(--bcds-typography-font-size-h3)"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var(--bcds-typography-font-size-h4)"
                }
            }
        },
        "blocks": {
            "core/navigation": {
            
                "css": "& > div:not(.has-modal-open) ul { max-width: var(--wp--style--global--content-size); margin: 0 auto !important; !important; }",
                "spacing": {
                    "blockGap": "var:preset|spacing|50",
                    "padding": {
                        "left":"var:preset|spacing|40",
                        "right":"var:preset|spacing|40"
                    },
                    "margin": {
                        "top": "0.5rem",
                        "bottom": "0.5rem"
                    }
                  
                    
                },
                "elements": {
                    "button":{
                        "color": {
                            "text": "cyan"
                        }
                    },
                    "link": {
                        "spacing": {
                            "padding": {
                                "right": "var:preset|spacing|40",
                                "left": "var:preset|spacing|40"
                            }
                        },
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        }
                    }
                }
            },
            "core/button": {
                "spacing": {
                    "margin": {
                        "top": "var:preset|spacing|40"
                    }
                },
                "variations": {
                    "outline": {
                        "color": {
                            "text": "var(--bcds-typography-color-secondary)",
                            "background": "var(--bcds-surface-color-secondary-button-default)"
                        }
                    }
                }
            },
            "core/latest-comments": {
                "spacing": {
                    "padding": {
                        "left": "0px"
                    }
                }
            },
            "core/list": {
                "spacing": {
                    "margin": {
                        "top": "var:preset|spacing|60"
                    }
                }
            },
            "core/template-part":{
                "spacing": {
                    "margin": {
                        "top": "0"
                    }
                }
            },
            "core/query-pagination": {
                "spacing": {
                    "margin": {
                        "top": "var:preset|spacing|50"
                    },
                    "padding":{
                        "top": "var:preset|spacing|40",
                        "bottom": "var:preset|spacing|40"
                    }
                },
                "border": {
                    "top": {
                        "width": "1px",
                        "style": "solid",
                        "color": "var(--bcds-surface-color-border-default)"
                    }
                }
            },
            "core/query-pagination-numbers": {
                "elements": {
                    "link": {
                        "spacing": {
                            "padding": {
                                "left": "var:preset|spacing|50",
                                "right": "var:preset|spacing|50"
                            },
                            "margin": {
                                "right": "var:preset|spacing|50"
                            }
                        }
                    }
                }
            },
            
            "core/post-template": {
                "elements": {
                    "heading": {
                        "border": {
                            "top": {
                                "style": "solid",
                                "width": "1px",
                                "color": "var(--bcds-surface-color-border-default)"
                            }
                        }
                    }
        
                }
            },
            "core/group": {
                "spacing": {
                    "padding": {
                        "left": "var:preset|spacing|50",
                        "right": "var:preset|spacing|50"
                    },
                    "margin": {
                        "bottom": "var:preset|spacing|30"
                    }
                }
            },
            "core/post-title": {
                "spacing": {
                    "padding": {
                        "top": "var:preset|spacing|30",
                        "bottom": "var:preset|spacing|60"
                    }
                },
                "border": {
                    "bottom": {
                        "color": "var(--bcds-surface-color-border-default)",
                        "style": "solid",
                        "width": "1px"
                    }
                }
            },
            "core/separator": {
                "border":{
                    "width": "1px"
                },
                "color": {
                    "text": "var(--bcds-surface-color-border-default)"
                },
                "spacing": {
                    "margin": {
                        "bottom": "0"
                    }
                }
            },
            "design-system-wordpress-plugin/breadcrumb": {
                "css": "width: inherit; & .dswp-block-breadcrumb__container { max-width: var(--wp--style--global--content-size); margin: 0 auto !important; !important; }",
                "spacing": {
                    "padding": {
                        "left": "var:preset|spacing|50",
                        "right": "var:preset|spacing|50"
                    }
                },
                "border":{
                    "bottom": {
                        "color": "var(--bcds-surface-color-border-default)",
                        "style": "solid",
                        "width": "1px"
                    }
                }
            }
        }
    }
}


