{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "bcew-starter-theme",
    "root": "themes/bcew-starter-theme",
    "sourceRoot": "themes/bcew-starter-theme/src",
    "projectType": "application",
    "generators": {
        "bcew-monorepo:theme": {
            "name": "bcew-starter-theme",
            "slug": "bcew-starter-theme"
        }
    },
    "targets": {
        "composer-install": {},
        "prepare-release": {},
        "build": {},
        "start": {},
        "start-playwright": {},
        "test-accessibility": {},
        "test-screenshot": {},
        "test-screenshot-generate": {},
        "lint-template-parts": {},
        "wp-env-start": {
            "dependsOn": [
                "composer-install",
                "build"
            ]
        },
        "test-integration": {
            "options": {
                "command": "wp-env run tests-cli --env-cwd=wp-content/themes/bcew-starter-theme composer test"
            },
            "dependsOn": ["composer-install", "build", "wp-env-start"]
        },
        "wp-env-clean": {},
        "wp-env-stop": {}
    },
    "implicitDependencies": ["packages/phpunit-config/"],
    "tags": ["type:wp-theme"]
}
