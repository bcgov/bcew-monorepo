{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "BCEW Theme 2",
	"customTemplates": [
		{
			"name": "secondary",
			"title": "Secondary page"
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#003366"
				},
				{
					"name": "Secondary",
					"slug": "secondary",
					"color": "#fcba19"
				},
				{
					"name": "Text",
					"slug": "text",
					"color": "#313132"
				},
				{
					"name": "Background",
					"slug": "background",
					"color": "#ffffff"
				},
				{
					"name": "Accent",
					"slug": "accent",
					"color": "#5475a7"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"name": "BC Sans",
					"slug": "bc-sans",
					"fontFamily": "\"BC Sans\", \"Noto Sans\", Verdana, Arial, sans-serif"
				}
			]
		},
		"layout": {
			"contentSize": "1200px"
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|background",
			"text": "var:preset|color|text"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|bc-sans"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var:preset|color|primary"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|background"
				}
			}
		}
	}
}
